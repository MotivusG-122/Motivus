
"use client";

import { useEffect, useMemo, useState } from "react";
import Image from "next/image";
import Link from "next/link";
import { usePathname, useRouter } from "next/navigation";

const API =
  process.env.NEXT_PUBLIC_API_BASE_URL || "http://localhost:8000";

type User = {
  id: number | string;
  full_name: string;
  email: string;
  role: string;
  is_active: boolean;
};

type JobStatus = "Planned" | "In Transit" | "Completed" | "Unassigned";

type Job = {
  id: string;
  type: "Pickup" | "Delivery";
  from: string;
  to: string;
  batteries: number;
  weight: number;
  status: JobStatus;
  vehicle: string;
};

const initialJobs: Job[] = [
  {
    id: "JOB-1001",
    type: "Pickup",
    from: "BRC Noida",
    to: "Dealer A",
    batteries: 18,
    weight: 360,
    status: "Planned",
    vehicle: "MH-01",
  },
  {
    id: "JOB-1002",
    type: "Delivery",
    from: "BRC Ghaziabad",
    to: "Dealer B",
    batteries: 12,
    weight: 240,
    status: "In Transit",
    vehicle: "MH-02",
  },
  {
    id: "JOB-1003",
    type: "Pickup",
    from: "Dealer C",
    to: "BRC Noida",
    batteries: 24,
    weight: 480,
    status: "Unassigned",
    vehicle: "—",
  },
  {
    id: "JOB-1004",
    type: "Delivery",
    from: "BRC Noida",
    to: "Dealer D",
    batteries: 10,
    weight: 200,
    status: "Planned",
    vehicle: "MH-01",
  },
  {
    id: "JOB-1005",
    type: "Pickup",
    from: "Dealer E",
    to: "BRC Ghaziabad",
    batteries: 8,
    weight: 160,
    status: "Completed",
    vehicle: "MH-03",
  },
];

const initialVehicles = [
  {
    id: "MH-01",
    name: "Vehicle 01",
    capacity: 1500,
    state: "On route",
  },
  {
    id: "MH-02",
    name: "Vehicle 02",
    capacity: 1200,
    state: "On route",
  },
  {
    id: "MH-03",
    name: "Vehicle 03",
    capacity: 1000,
    state: "Available",
  },
];

const navItems = [
  ["Overview", "▦", "/"],
  ["Daily Planning", "↗", "/daily-planning"],
  ["Live Operations", "⌖", "/live-operations"],
  ["Movements", "⇄", "/movements"],
  ["Vehicles & Batteries", "▤", "/vehicles-batteries"],
  ["Route Analysis", "⇄", "/route-analysis"],
  ["Reports", "▥", "/reports"],
] as const;

function Status({ value }: { value: string }) {
  const styles: Record<string, string> = {
    Planned: "blue",
    "In Transit": "amber",
    Completed: "green",
    Unassigned: "red",
    "On route": "amber",
    Available: "green",
    Resolved: "green",
  };

  return (
    <span className={`status ${styles[value] || "blue"}`}>
      {value}
    </span>
  );
}

export default function Home() {
  const pathname = usePathname();
  const router = useRouter();

  const active =
    navItems.find(([, , href]) => href === pathname)?.[0] ?? "Overview";

  const [today, setToday] = useState("");
  const [user, setUser] = useState<User | null>(null);
  const [profileOpen, setProfileOpen] = useState(false);
  const [loggingOut, setLoggingOut] = useState(false);
  const [authError, setAuthError] = useState("");

  const [jobs, setJobs] = useState<Job[]>(initialJobs);
  const [query, setQuery] = useState("");
  const [filter, setFilter] = useState("All");
  const [optimized, setOptimized] = useState(false);
  const [notice, setNotice] = useState("");

  // Automatically update the displayed date using Indian Standard Time.
  useEffect(() => {
    const updateDate = () => {
      setToday(
        new Intl.DateTimeFormat("en-GB", {
          weekday: "long",
          day: "2-digit",
          month: "long",
          year: "numeric",
          timeZone: "Asia/Kolkata",
        }).format(new Date())
      );
    };

    updateDate();

    const interval = window.setInterval(updateDate, 60_000);
    return () => window.clearInterval(interval);
  }, []);

  // Fetch the currently authenticated account.
  useEffect(() => {
    let cancelled = false;

    async function loadUser() {
      try {
        const response = await fetch(`${API}/auth/me`, {
          credentials: "include",
          cache: "no-store",
        });

        if (response.status === 401 || response.status === 403) {
          router.replace("/login");
          return;
        }

        if (!response.ok) {
          throw new Error("Unable to load account");
        }

        const data: User = await response.json();

        if (!cancelled) {
          setUser(data);
          setAuthError("");
        }
      } catch {
        if (!cancelled) {
          setAuthError(
            "Account details unavailable. Please check the backend connection."
          );
        }
      }
    }

    loadUser();

    return () => {
      cancelled = true;
    };
  }, [router]);

  async function handleLogout() {
    setLoggingOut(true);
    setAuthError("");

    try {
      const response = await fetch(`${API}/auth/logout`, {
        method: "POST",
        credentials: "include",
      });

      if (!response.ok) {
        throw new Error("Logout request failed");
      }

      setProfileOpen(false);
      router.replace("/login");
      router.refresh();
    } catch {
      setAuthError("Logout failed. Check the backend and try again.");
      setLoggingOut(false);
    }
  }

  const initials =
    user?.full_name
      ?.trim()
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((part) => part[0])
      .join("")
      .toUpperCase() || "U";

  const vehicles = useMemo(() => {
    return initialVehicles.map((vehicle) => {
      const load = jobs
        .filter(
          (job) =>
            job.vehicle === vehicle.id && job.status !== "Completed"
        )
        .reduce((sum, job) => sum + job.weight, 0);

      return { ...vehicle, load };
    });
  }, [jobs]);

  const filteredJobs = jobs.filter((job) => {
    const matchesQuery =
      `${job.id} ${job.from} ${job.to} ${job.vehicle}`
        .toLowerCase()
        .includes(query.toLowerCase());

    return (
      matchesQuery &&
      (filter === "All" || job.status === filter)
    );
  });

  const completed = jobs.filter(
    (job) => job.status === "Completed"
  ).length;

  const unassigned = jobs.filter(
    (job) => job.status === "Unassigned"
  ).length;

  const activeJobs = jobs.filter(
    (job) => job.status !== "Completed"
  ).length;

  function runDemoOptimization() {
    const loads: Record<string, number> = Object.fromEntries(
      vehicles.map((vehicle) => [vehicle.id, vehicle.load])
    );

    const nextJobs = jobs.map((job): Job => {
      if (job.status !== "Unassigned") return job;

      const candidate = vehicles
        .map((vehicle) => ({
          id: vehicle.id,
          remaining: vehicle.capacity - loads[vehicle.id],
        }))
        .filter((vehicle) => vehicle.remaining >= job.weight)
        .sort((a, b) => b.remaining - a.remaining)[0];

      if (!candidate) return job;

      loads[candidate.id] += job.weight;

      return {
        ...job,
        vehicle: candidate.id,
        status: "Planned",
      };
    });

    const stillUnassigned = nextJobs.filter(
      (job) => job.status === "Unassigned"
    ).length;

    setJobs(nextJobs);
    setOptimized(true);

    setNotice(
      stillUnassigned
        ? `${stillUnassigned} job(s) could not be allocated. This is a demo; OR-Tools is not connected.`
        : "Demo assignments updated. Verify capacity before approval. OR-Tools is not connected."
    );
  }

  function resetDemo() {
    setJobs(initialJobs);
    setOptimized(false);
    setNotice("Demo data restored.");
  }

  function completeJob(id: string) {
    setJobs((current) =>
      current.map((job) =>
        job.id === id
          ? { ...job, status: "Completed" }
          : job
      )
    );

    setNotice(`${id} marked completed in the demo.`);
  }

  return (
    <main className="shell">
      <aside className="sidebar">
        <div className="brand">
          <Image
            src="/Motivus%20Logo.png"
            alt="Motivus"
            width={180}
            height={75}
            priority
            className="object-contain"
          />
        </div>

        <div className="workspace-label">WORKSPACE</div>

        <nav>
          {navItems.map(([label, icon, href]) => (
            <Link
              key={label}
              href={href}
              className={`nav-item ${
                active === label ? "selected" : ""
              }`}
            >
              <span className="nav-icon">{icon}</span>
              {label}
              {label === "Live Operations" && (
                <span className="live-dot" />
              )}
            </Link>
          ))}
        </nav>

        {/* The old bottom-left user panel has been removed. */}
      </aside>

      <section className="main-area">
        <header className="topbar">
          <div className="breadcrumb">
            Workspace <span>/</span> {active}
          </div>

          <div className="top-actions">

            <button
              type="button"
              className="icon-button"
              title="Notifications"
              aria-label="Notifications"
              onClick={() =>
                setNotice("Notifications are not connected yet.")
              }
            >
              ♧
            </button>

            <div style={{ position: "relative" }}>
              <button
                type="button"
                className="avatar small"
                title="Account menu"
                aria-label="Open account menu"
                aria-expanded={profileOpen}
                onClick={() => {
                  setProfileOpen((open) => !open);
                  setAuthError("");
                }}
                style={{ cursor: "pointer", border: "none" }}
              >
                {initials}
              </button>

              {profileOpen && (
                <div
                  role="menu"
                  style={{
                    position: "absolute",
                    right: 0,
                    top: "calc(100% + 12px)",
                    width: "min(300px, calc(100vw - 40px))",
                    padding: 12,
                    background: "#fff",
                    border: "1px solid #e3e9dc",
                    borderRadius: 14,
                    boxShadow: "0 12px 36px rgba(20,40,30,.16)",
                    zIndex: 100,
                    color: "#20352b",
                  }}
                >
                  <div
                    style={{
                      padding: "8px 8px 14px",
                      borderBottom: "1px solid #edf0e8",
                    }}
                  >
                    <div
                      style={{
                        fontWeight: 700,
                        overflowWrap: "anywhere",
                      }}
                    >
                      {user?.full_name || "Account"}
                    </div>

                    <div
                      style={{
                        marginTop: 4,
                        fontSize: 12,
                        color: "#718074",
                        overflowWrap: "anywhere",
                      }}
                    >
                      {user?.email || "Account details unavailable"}
                    </div>

                    {user && (
                      <div
                        style={{
                          marginTop: 6,
                          fontSize: 12,
                          color: "#718074",
                          textTransform: "capitalize",
                        }}
                      >
                        {user.role.replaceAll("_", " ")}
                        {" · "}
                        {user.is_active ? "Active" : "Inactive"}
                      </div>
                    )}
                  </div>

                  <Link
                    href="/profile"
                    role="menuitem"
                    onClick={() => setProfileOpen(false)}
                    style={{
                      display: "block",
                      padding: "12px 8px",
                      marginTop: 4,
                      borderRadius: 8,
                      color: "#20352b",
                      textDecoration: "none",
                      fontSize: 14,
                    }}
                  >
                    ◎ &nbsp; My Profile
                  </Link>

                  <button
                    type="button"
                    role="menuitem"
                    onClick={handleLogout}
                    disabled={loggingOut}
                    style={{
                      display: "block",
                      width: "100%",
                      textAlign: "left",
                      padding: "12px 8px",
                      border: 0,
                      borderRadius: 8,
                      background: "transparent",
                      color: "#b42318",
                      cursor: loggingOut ? "wait" : "pointer",
                      fontSize: 14,
                      fontWeight: 600,
                      opacity: loggingOut ? 0.6 : 1,
                    }}
                  >
                    {loggingOut ? "Signing out..." : "↪ Logout"}
                  </button>

                  {authError && (
                    <p
                      role="alert"
                      style={{
                        margin: "6px 8px",
                        color: "#b42318",
                        fontSize: 12,
                      }}
                    >
                      {authError}
                    </p>
                  )}
                </div>
              )}
            </div>
          </div>
        </header>

        <div className="content">
          <div className="page-heading">
            <div>
              <h1>{active}</h1>
              <p className="subtitle">
                Manage daily battery movement, vehicle allocation and delivery operations.
              </p>
            </div>

            <div className="heading-actions">
              <button className="button secondary" onClick={resetDemo}>
                ↻ Reset demo
              </button>
              <button
                className="button primary"
                onClick={runDemoOptimization}
              >
                ✦ Optimize plan
              </button>
            </div>
          </div>

          {notice && (
            <div className="notice">
              <span>ⓘ</span> {notice}
              <button
                type="button"
                onClick={() => setNotice("")}
                aria-label="Dismiss notice"
              >
                ×
              </button>
            </div>
          )}

          <div className="date-row">
            <div className="date-chip">
              ▦ &nbsp; {today || "Loading date..."}
            </div>
            <span className="plan-status">
              <span /> Planning workspace
            </span>
          </div>

          <div className="metrics">
            <Metric
              label="Total jobs"
              value={String(jobs.length).padStart(2, "0")}
              note="Today's operational plan"
              icon="▤"
              tone="blue"
            />
            <Metric
              label="Active vehicles"
              value={String(vehicles.length).padStart(2, "0")}
              note="Fleet in demo"
              icon="▣"
              tone="purple"
            />
            <Metric
              label="Jobs completed"
              value={`${completed}/${jobs.length}`}
              note={`${Math.round((completed / jobs.length) * 100)}% completion`}
              icon="✓"
              tone="green"
            />
            <Metric
              label="Unassigned jobs"
              value={String(unassigned).padStart(2, "0")}
              note="Require allocation"
              icon="⚑"
              tone="orange"
            />
          </div>

          <div className="section-grid">
            <section className="panel route-panel">
              <div className="panel-header">
                <div>
                  <h2>Network overview</h2>
                  <p>Illustrative regional movement</p>
                </div>
                <span className="live-tag">
                  <span /> DEMO MAP
                </span>
              </div>

              <div className="map-canvas">
                <div className="map-grid" />
                <svg
                  className="route-svg"
                  viewBox="0 0 600 320"
                  preserveAspectRatio="none"
                >
                  <path
                    d="M 80 220 C 150 200 140 100 235 110 S 350 240 435 175 S 510 80 550 90"
                    className="route-line route-one"
                  />
                  <path
                    d="M 80 220 C 180 270 230 235 315 220 S 400 120 435 175"
                    className="route-line route-two"
                  />
                  <path
                    d="M 235 110 Q 290 55 360 72 T 550 90"
                    className="route-line route-three"
                  />
                </svg>

                {[
                  { name: "BRC Noida", x: 13, y: 66, cls: "hub" },
                  { name: "BRC Ghaziabad", x: 39, y: 33, cls: "hub" },
                  { name: "Dealer A", x: 73, y: 52, cls: "" },
                  { name: "Dealer B", x: 53, y: 70, cls: "" },
                  { name: "Dealer C", x: 86, y: 25, cls: "" },
                ].map((point) => (
                  <div
                    key={point.name}
                    className="map-point"
                    style={{
                      left: `${point.x}%`,
                      top: `${point.y}%`,
                    }}
                  >
                    <span className={`point-dot ${point.cls}`} />
                    <span className="point-label">{point.name}</span>
                  </div>
                ))}

                <div className="map-legend">
                  <span><i className="legend-hub" /> BRC</span>
                  <span><i className="legend-dealer" /> Pickup / delivery</span>
                  <span><i className="legend-route" /> Planned route</span>
                </div>

                <div className="map-disclaimer">
                  Illustrative map · Not geographic coordinates
                </div>
              </div>

              <div className="route-summary">
                <div><span>Planned distance</span><strong>186 km</strong></div>
                <div><span>Estimated duration</span><strong>4h 35m</strong></div>
                <div><span>Route coverage</span><strong>80%</strong></div>
              </div>
            </section>

            <section className="panel vehicle-panel">
              <div className="panel-header">
                <div>
                  <h2>Fleet status</h2>
                  <p>Vehicle payload utilization</p>
                </div>
                <Link className="text-button" href="/vehicles-batteries">
                  View fleet →
                </Link>
              </div>

              <div className="vehicle-list">
                {vehicles.map((vehicle) => {
                  const pct = Math.min(
                    100,
                    Math.round((vehicle.load / vehicle.capacity) * 100)
                  );

                  return (
                    <div className="vehicle-card" key={vehicle.id}>
                      <div className="vehicle-top">
                        <div className="vehicle-symbol">▰</div>
                        <div className="vehicle-info">
                          <strong>{vehicle.name}</strong>
                          <span>{vehicle.id}</span>
                        </div>
                        <Status value={vehicle.state} />
                      </div>

                      <div className="capacity-label">
                        <span>Payload utilization</span>
                        <strong>{pct}%</strong>
                      </div>
                      <div className="progress">
                        <span style={{ width: `${pct}%` }} />
                      </div>
                      <div className="capacity-foot">
                        <span>{vehicle.load.toLocaleString()} kg loaded</span>
                        <span>{vehicle.capacity.toLocaleString()} kg capacity</span>
                      </div>
                    </div>
                  );
                })}
              </div>
            </section>
          </div>

          <section className="panel jobs-panel">
            <div className="panel-header jobs-header">
              <div>
                <h2>Today&apos;s pickup &amp; delivery jobs</h2>
                <p>Review allocations and job status</p>
              </div>
              <button
                className="button secondary small-button"
                onClick={() =>
                  setNotice("CSV export will be enabled in a later integration phase.")
                }
              >
                ↓ Export
              </button>
            </div>

            <div className="table-tools">
              <div className="search-box">
                <span>⌕</span>
                <input
                  value={query}
                  onChange={(event) => setQuery(event.target.value)}
                  placeholder="Search job, location or vehicle..."
                />
              </div>

              <select
                value={filter}
                onChange={(event) => setFilter(event.target.value)}
              >
                {["All", "Planned", "In Transit", "Completed", "Unassigned"].map(
                  (status) => (
                    <option key={status} value={status}>
                      {status}
                    </option>
                  )
                )}
              </select>
            </div>

            <div className="table-scroll">
              <table>
                <thead>
                  <tr>
                    <th>JOB ID</th>
                    <th>TYPE</th>
                    <th>PICKUP / ORIGIN</th>
                    <th>DELIVERY / DESTINATION</th>
                    <th>BATTERIES</th>
                    <th>TOTAL WEIGHT</th>
                    <th>VEHICLE</th>
                    <th>STATUS</th>
                    <th>ACTION</th>
                  </tr>
                </thead>

                <tbody>
                  {filteredJobs.map((job) => (
                    <tr key={job.id}>
                      <td className="job-id">{job.id}</td>
                      <td>
                        <span className={`job-type ${job.type.toLowerCase()}`}>
                          {job.type}
                        </span>
                      </td>
                      <td>{job.from}</td>
                      <td>{job.to}</td>
                      <td>{job.batteries}</td>
                      <td>{job.weight} kg</td>
                      <td>{job.vehicle}</td>
                      <td><Status value={job.status} /></td>
                      <td>
                        {job.status !== "Completed" && (
                          <button
                            className="row-action"
                            title="Mark completed"
                            aria-label={`Mark ${job.id} completed`}
                            onClick={() => completeJob(job.id)}
                          >
                            ✓
                          </button>
                        )}
                      </td>
                    </tr>
                  ))}

                  {filteredJobs.length === 0 && (
                    <tr>
                      <td colSpan={9} className="empty">
                        No jobs match this filter.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>

            <div className="table-footer">
              Showing {filteredJobs.length} of {jobs.length} sample jobs
              <span>Demo records only · Not live company data</span>
            </div>
          </section>

          <div className="bottom-grid">
            <section className="panel">
              <div className="panel-header">
                <div>
                  <h2>Operational alerts</h2>
                  <p>Items requiring attention</p>
                </div>
              </div>

              <div className="alert-item">
                <span className="alert-icon warning">!</span>
                <div>
                  <strong>Unassigned pickup job</strong>
                  <p>JOB-1003 · Dealer C · 480 kg</p>
                </div>
                <Status value={unassigned ? "Unassigned" : "Resolved"} />
              </div>

              <div className="alert-item">
                <span className="alert-icon info">i</span>
                <div>
                  <strong>Tracking is simulated</strong>
                  <p>No real GPS or traffic feed connected.</p>
                </div>
              </div>
            </section>

            <section className="panel">
              <div className="panel-header">
                <div>
                  <h2>Optimization summary</h2>
                  <p>Latest demo action</p>
                </div>
              </div>

              <div className="summary-row">
                <span>Plan status</span>
                <strong>{optimized ? "Demo updated" : "Awaiting optimization"}</strong>
              </div>
              <div className="summary-row">
                <span>Unassigned jobs</span>
                <strong>{unassigned}</strong>
              </div>
              <div className="summary-row">
                <span>Jobs in active plan</span>
                <strong>{activeJobs}</strong>
              </div>
              <div className="summary-note">
                Final route feasibility, distance and cost require the backend optimizer and approved routing data.
              </div>
            </section>
          </div>

          <footer>
            Motivus Logistics Optimizer · Prototype v0.1
            <span>Sample data · For internal review</span>
          </footer>
        </div>
      </section>
    </main>
  );
}

function Metric({
  label,
  value,
  note,
  icon,
  tone,
}: {
  label: string;
  value: string;
  note: string;
  icon: string;
  tone: string;
}) {
  return (
    <section className="metric-card">
      <div className="metric-top">
        <span>{label}</span>
        <span className={`metric-icon ${tone}`}>{icon}</span>
      </div>
      <div className="metric-value">{value}</div>
      <div className="metric-note">{note}</div>
    </section>
  );
}
